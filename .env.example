# Cashcast — environment template (SPEC §7).
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# This file MUST stay in sync with src/lib/env.ts and src/modules/ai/env.ts.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/cashcast?schema=public"

# ─── LINE Messaging API (bot) ────────────────────────────────────────────────
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# ─── LINE Login (a separate channel from the bot) ────────────────────────────
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""

# ─── Session ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# At least 32 characters: openssl rand -base64 32
SESSION_SECRET=""

# ─── Email ingestion (Cloudflare Email Routing → Worker) ─────────────────────
EMAIL_INGEST_DOMAIN=""
EMAIL_WORKER_SECRET=""

# ─── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=""

# ─── AI (S11) ────────────────────────────────────────────────────────────────
# Read only by src/modules/ai/. Server-side only — never expose to the client
# (SEC-18). With AI_ENABLED=false every P0 feature must still work.
AI_ENABLED="false"
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
AI_MONTHLY_BUDGET_THB="80"
AI_RATE_LIMIT_PER_USER_DAY="20"
AI_EMAIL_DAILY_LIMIT="50"
AI_TIMEOUT_MS="8000"
AI_CACHE_TTL_DAYS="90"
