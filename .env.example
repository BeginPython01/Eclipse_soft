# จดตัง (Jodtang) — copy to .env and fill in.
# This file MUST stay in sync with the code (AIDO §10). .env MUST NOT be committed.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/jodtang?schema=public"

# ── LINE Messaging API (the bot) ────────────────────────────────────────────
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── LINE Login v2.1 (web auth) ──────────────────────────────────────────────
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ── Session ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# 32+ random bytes. Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Email ingestion (Cloudflare Email Routing → Worker) ─────────────────────
EMAIL_INGEST_DOMAIN=
EMAIL_WORKER_SECRET=

# ── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── AI (S11) ────────────────────────────────────────────────────────────────
# Setting AI_ENABLED=false must leave every P0 feature working (AIDO §5.2 A4).
AI_ENABLED=true
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Hard cap. Also configure a spending cap in the provider dashboard — a code
# limit can be defeated by a bug, a provider limit cannot (SPEC §3.11.6).
AI_MONTHLY_BUDGET_THB=80
AI_RATE_LIMIT_PER_USER_DAY=20
AI_EMAIL_DAILY_LIMIT=50
AI_TIMEOUT_MS=8000
AI_CACHE_TTL_DAYS=90
